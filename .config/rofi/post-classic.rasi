/* Modern, Minimalist & Elegant Theme for Rofi -> Catppuccin */
* {
    /* Catppuccin Mocha Palette */
    bg-base:      #1e1e2ef2; /* Lớp nền đen nhạt, hơi mờ */
    bg-surface:   #313244;   /* Lớp nền nổi (ô panel/search) */
    bg-highlight: #45475a;   /* Nền khi hover chọn */
    fg-text:      #cdd6f4;   /* Chữ trắng ngà */
    fg-dim:       #a6adc8;   /* Chữ mờ (placeholder) */
    accent:       #cba6f7;   /* Màu Lavender dịu nhẹ */

    background-color: transparent;
    text-color: @fg-text;
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg-base;
    border: 1px solid;
    border-color: @bg-surface;
    border-radius: 12px;
    width: 650px;
}

mainbox {
    padding: 24px;
    spacing: 20px;
}

inputbar {
    background-color: @bg-surface;
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 16px;
    children: [prompt, entry];
}

prompt {
    font: "JetBrainsMono Nerd Font Bold 12";
    text-color: @bg-base;
    background-color: @accent;
    padding: 4px 12px;
    border-radius: 6px;
    vertical-align: 0.5;
}

entry {
    font: "JetBrainsMono Nerd Font 12";
    placeholder: "Tìm kiếm...";
    placeholder-color: @fg-dim;
    text-color: @fg-text;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    border: 0px;
    scrollbar: false;
}

element {
    padding: 12px 16px;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    padding: 0 16px 0 0;
}

element-text {
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
    text-color: inherit;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-highlight;
    text-color: @accent;
}
